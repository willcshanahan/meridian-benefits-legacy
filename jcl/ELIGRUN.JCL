//MBAELIG JOB (MBA,BENEFITS),'ELIG RERUN',CLASS=B,MSGCLASS=X,
//             NOTIFY=&SYSUID,REGION=2048K
//*
//********************************************************************
//* ELIGRUN - STANDALONE RERUN OF MBA100 ELIGCALC                     *
//*                                                                   *
//* USED WHEN THE FIELD OFFICES CORRECT A BATCH OF CLAIMANT MASTER    *
//* RECORDS AFTER THE NIGHTLY CYCLE HAS ALREADY RUN.  THIS JOB ONLY   *
//* REBUILDS THE DETERMINATION FILE.  IT DOES NOT PAY ANYBODY.        *
//* AFTER A CLEAN RC=0 SUBMIT NIGHTLY.JCL WITH RESTART=BENESTEP.      *
//*                                                                   *
//* CHECK BEFORE SUBMIT                                               *
//*   1. NO OTHER MBA JOB IS HOLDING MBA.PROD.CLAIMANT.EXTRACT        *
//*   2. THE PRIOR GENERATION OF THE DETERMINATION FILE IS CATALOGED  *
//*      (+0) - THIS JOB CREATES +1                                   *
//*   3. OPERATIONS HAS BEEN TOLD, BECAUSE THE COUNTY EXTRACT JOB     *
//*      READS THE SAME GDG AND WILL PICK UP WHATEVER IS NEWEST       *
//********************************************************************
//*
//DELSTEP  EXEC PGM=IEFBR14
//SYSPRINT DD SYSOUT=*
//*
//ELIGSTEP EXEC PGM=ELIGCALC,COND=(0,NE)
//STEPLIB  DD DSN=MBA.PROD.LOADLIB,DISP=SHR
//CLAIMIN  DD DSN=MBA.PROD.CLAIMANT.EXTRACT,DISP=SHR
//ELIGOUT  DD DSN=MBA.PROD.DETERM(+1),DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSDA,SPACE=(TRK,(15,5),RLSE),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=27920)
//ELIGAUD  DD DSN=MBA.PROD.ELIG.AUDIT,DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSDA,SPACE=(TRK,(1,1),RLSE),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=27920)
//SYSOUT   DD SYSOUT=*
//SYSPRINT DD SYSOUT=*
//SYSUDUMP DD SYSOUT=D
//*
//PRTSTEP  EXEC PGM=IEBGENER,COND=(0,NE)
//SYSUT1   DD DSN=MBA.PROD.ELIG.AUDIT,DISP=SHR
//SYSUT2   DD SYSOUT=*
//SYSIN    DD DUMMY
//SYSPRINT DD SYSOUT=*
//
