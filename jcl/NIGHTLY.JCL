//MBANITE JOB (MBA,BENEFITS),'NIGHTLY BENEFIT CYCLE',CLASS=A,
//             MSGCLASS=X,NOTIFY=&SYSUID,REGION=4096K
//*
//********************************************************************
//* NIGHTLY - MERIDIAN STATE BENEFITS AGENCY NIGHTLY BENEFIT CYCLE    *
//*                                                                   *
//* STEP SEQUENCE                                                     *
//*   ELIGSTEP  MBA100 ELIGCALC  CLAIMANT EXTRACT -> DETERMINATIONS    *
//*   BENESTEP  MBA200 BENEFITS  DETERMINATIONS   -> BENEFIT AMOUNTS   *
//*   PAYSTEP   MBA300 PAYCALC   BENEFIT AMOUNTS  -> PAYMENT SCHEDULE  *
//*   SORTSTEP  DFSORT           PAYMENTS BY COUNTY THEN CASE ID       *
//*   REPTSTEP  MBA400 REPTGEN   SORTED PAYMENTS  -> MBA-400 REGISTER  *
//*                                                                   *
//* EVERY STEP AFTER ELIGSTEP IS COND=(0,NE) - ONE BAD RETURN CODE     *
//* STOPS THE CYCLE.  DO NOT ADD COND CODE OVERRIDES TO "GET THE       *
//* WARRANTS OUT".  THAT WAS DONE IN 1991 AND THE AGENCY SPENT THREE   *
//* MONTHS RECOVERING DUPLICATE WARRANTS.                              *
//*                                                                   *
//* RESTART GUIDANCE                                                   *
//*   BENESTEP FORWARD ARE RESTARTABLE WITH RESTART=STEPNAME PROVIDED  *
//*   THE +1 GENERATION FROM THE FAILED RUN IS UNCATALOGED FIRST.      *
//*   ELIGSTEP IS NOT RESTARTABLE IN PLACE - USE ELIGRUN.JCL.          *
//*                                                                   *
//* THE PAYCTL CARD IS THE ONLY PLACE THE CYCLE DATE, INSTALLMENT      *
//* DAYS AND WARRANT SEED ARE STATED.  OPERATIONS UPDATES IT FROM THE  *
//* WARRANT LOG BEFORE EACH CYCLE.  A STALE SEED MEANS DUPLICATE       *
//* WARRANT NUMBERS AND A MANUAL RECONCILIATION WITH THE TREASURER.    *
//********************************************************************
//*
//ELIGSTEP EXEC PGM=ELIGCALC
//STEPLIB  DD DSN=MBA.PROD.LOADLIB,DISP=SHR
//CLAIMIN  DD DSN=MBA.PROD.CLAIMANT.EXTRACT,DISP=SHR
//ELIGOUT  DD DSN=&&DETERM,DISP=(NEW,PASS,DELETE),
//            UNIT=SYSDA,SPACE=(TRK,(15,5),RLSE),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=27920)
//ELIGAUD  DD DSN=MBA.PROD.ELIG.AUDIT,DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSDA,SPACE=(TRK,(1,1),RLSE),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=27920)
//SYSOUT   DD SYSOUT=*
//SYSUDUMP DD SYSOUT=D
//*
//BENESTEP EXEC PGM=BENEFITS,COND=(0,NE)
//STEPLIB  DD DSN=MBA.PROD.LOADLIB,DISP=SHR
//BENEIN   DD DSN=&&DETERM,DISP=(OLD,DELETE,DELETE)
//BENEOUT  DD DSN=&&BENAMT,DISP=(NEW,PASS,DELETE),
//            UNIT=SYSDA,SPACE=(TRK,(15,5),RLSE),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=27920)
//BENEAUD  DD DSN=MBA.PROD.BENE.AUDIT,DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSDA,SPACE=(TRK,(1,1),RLSE),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=27920)
//SYSOUT   DD SYSOUT=*
//SYSUDUMP DD SYSOUT=D
//*
//PAYSTEP  EXEC PGM=PAYCALC,COND=(0,NE)
//STEPLIB  DD DSN=MBA.PROD.LOADLIB,DISP=SHR
//PAYIN    DD DSN=&&BENAMT,DISP=(OLD,PASS,DELETE)
//PAYCTL   DD DSN=MBA.PROD.PARMLIB(PAYCYCLE),DISP=SHR
//PAYOUT   DD DSN=MBA.PROD.PAYSCHED(+1),DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSDA,SPACE=(TRK,(20,5),RLSE),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=27920)
//PAYAUD   DD DSN=MBA.PROD.PAY.AUDIT,DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSDA,SPACE=(TRK,(1,1),RLSE),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=27920)
//SYSOUT   DD SYSOUT=*
//SYSUDUMP DD SYSOUT=D
//*
//SORTSTEP EXEC PGM=SORT,COND=(0,NE)
//SORTIN   DD DSN=MBA.PROD.PAYSCHED(+1),DISP=SHR
//SORTOUT  DD DSN=&&PAYSORT,DISP=(NEW,PASS,DELETE),
//            UNIT=SYSDA,SPACE=(TRK,(20,5),RLSE),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=27920)
//SORTWK01 DD UNIT=SYSDA,SPACE=(CYL,(5,2))
//SORTWK02 DD UNIT=SYSDA,SPACE=(CYL,(5,2))
//SYSIN    DD *
  SORT FIELDS=(10,3,CH,A,1,9,CH,A)
/*
//SYSOUT   DD SYSOUT=*
//*
//REPTSTEP EXEC PGM=REPTGEN,COND=(0,NE)
//STEPLIB  DD DSN=MBA.PROD.LOADLIB,DISP=SHR
//REPTIN   DD DSN=&&PAYSORT,DISP=(OLD,DELETE,DELETE)
//REPTCTL  DD DSN=MBA.PROD.PARMLIB(PAYCYCLE),DISP=SHR
//REPTOUT  DD SYSOUT=A,DCB=(RECFM=FBA,LRECL=132,BLKSIZE=13200),
//            DEST=CENTRALPRT
//SYSOUT   DD SYSOUT=*
//SYSUDUMP DD SYSOUT=D
//*
//RCSTEP   EXEC PGM=IEBGENER,COND=(0,NE)
//SYSUT1   DD DSN=MBA.PROD.PAY.AUDIT,DISP=SHR
//SYSUT2   DD SYSOUT=*
//SYSIN    DD DUMMY
//SYSPRINT DD SYSOUT=*
//
